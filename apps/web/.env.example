# 数据库（PostgreSQL）
DATABASE_URL="postgresql://user:password@localhost:5432/moxing"

# 大模型（OpenAI 兼容接口：DeepSeek / 通义千问 / 豆包）。不填则使用规则模板解读。
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY=""
AI_MODEL_FAST="deepseek-chat"
AI_MODEL_PRO="deepseek-chat"

# 短信：dev（验证码打印在服务端日志，并在开发环境直接返回）或 aliyun
SMS_PROVIDER="dev"
# 仅内测用：生产环境下也把验证码显示在页面上（上线前务必关掉）
SMS_DEV_ECHO="false"
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# 内测邀请制：true 时新用户注册必须填邀请码
INVITE_REQUIRED="true"

# 管理接口（生成兑换码）用的令牌
ADMIN_TOKEN=""

# 站点信息（备案号显示在页脚）
NEXT_PUBLIC_ICP=""
# 运营主体与联系方式（显示在用户协议、隐私政策中）
NEXT_PUBLIC_COMPANY=""
NEXT_PUBLIC_CONTACT=""
